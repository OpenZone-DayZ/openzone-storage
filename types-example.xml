<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Central economy entries for the boxes and their kits: copy into the
     mission's own types.xml (or a cfgeconomycore.xml include). Boxes are
     never spawned by the economy (nominal 0); their lifetime keeps a placed
     box from being cleaned up for 45 days without a visit. Kits are not
     spawned either until the server owner decides where they come from. -->
<types>
